{
  "name": "karaoke-scena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Karaoke — minimalist player with a synced lyric stage",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --format=esm --target=es2020 --jsx=automatic --minify --outfile=js/app.bundle.js",
    "build:watch": "esbuild src/main.jsx --bundle --format=esm --target=es2020 --jsx=automatic --outfile=js/app.bundle.js --watch",
    "serve": "php -S 127.0.0.1:8123 -t .",
    "pretest": "npm run build",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "test:headed": "playwright test --headed",
    "test:a11y": "playwright test tests/a11y.spec.js",
    "test:visual": "playwright test tests/visual.spec.js",
    "test:report": "playwright show-report",
    "lighthouse": "lighthouse http://127.0.0.1:8123 --chrome-path=\"C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe\" --only-categories=performance,accessibility,best-practices,seo --output=json --output-path=.artifacts/lighthouse.json --chrome-flags=\"--headless=new\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
